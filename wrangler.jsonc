{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "broadstreet-net",
  "compatibility_date": "2026-09-01",
  // Tiny Worker that only handles legacy query-string redirects (?page=1);
  // everything else is served straight from the static assets.
  "main": "worker/index.js",
  // Build the site before every deploy, so `wrangler deploy` works even if
  // Cloudflare's "Build command" setting is left empty.
  "build": { "command": "npm run build" },
  // Custom domains for this Worker. Every deploy replaces the Worker's domains with
  // exactly this list, so a domain added only in the Cloudflare dashboard is removed
  // on the next deploy. Add or remove domains here, not in the dashboard.
  // The broadstreet.net zone is in the same Cloudflare account, so deploy creates
  // the DNS records and SSL certs.
  "routes": [
    { "pattern": "broadstreet.net", "custom_domain": true },
    { "pattern": "www.broadstreet.net", "custom_domain": true },
    { "pattern": "dev.broadstreet.net", "custom_domain": true }
  ],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/portfolio", "/portfolio/", "/blogs", "/blogs/"]
  },
  "observability": { "enabled": true }
}
