{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "broadstreet-net",
  "compatibility_date": "2026-09-01",
  // Tiny Worker that only handles legacy query-string redirects (?page=1);
  // everything else is served straight from the static assets.
  "main": "worker/index.js",
  // Build the site before every deploy, so `wrangler deploy` works even if
  // Cloudflare's "Build command" setting is left empty.
  "build": { "command": "npm run build" },
  // Serve the site on dev.broadstreet.net. Because the broadstreet.net zone is in
  // the same Cloudflare account, deploy creates the DNS record and SSL cert.
  "routes": [{ "pattern": "dev.broadstreet.net", "custom_domain": true }],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/portfolio", "/portfolio/", "/blogs", "/blogs/"]
  },
  "observability": { "enabled": true }
}
